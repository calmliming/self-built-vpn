# Copy to .env, fill in your own values, and keep .env out of Git.
# Deployment host and local SSH key path
VPN_SERVER_IP=203.0.113.10
VPN_SSH_USER=ubuntu
VPN_SSH_KEY=~/.ssh/vpn.pem
VPN_SSH_PORT=22

# Optional AWS identifiers for private deployment records
VPN_AWS_REGION=us-east-1
VPN_AWS_SECURITY_GROUP_ID=
VPN_AWS_INSTANCE_ID=

# Node names and listening ports
VPN_NODE_PREFIX=AWS-US
VPN_NODE_NAME_STYLE=protocol
VPN_AI_GROUP_NAME=US-AI
VPN_AUTO_GROUP_NAME=US-AUTO
VPN_RULES_GROUP_NAME=US-RULES
VPN_REALITY_PORT=443
VPN_REALITY_ALT_PORT=20001
VPN_TROJAN_PORT=20002
VPN_HYSTERIA2_PORT=20003
# Optional Hysteria2 obfuscation: empty or salamander. Password is generated on the server.
VPN_HYSTERIA2_OBFS=
# Optional authenticated HTTP/SOCKS5 over TLS. 0 disables an endpoint.
VPN_HTTP_PORT=0
VPN_SOCKS5_PORT=0
VPN_NGINX_TLS_PORT=8443

# Failover and public acceptance tests
VPN_HEALTHCHECK_URL=https://www.gstatic.com/generate_204
VPN_HEALTHCHECK_INTERVAL=300
VPN_HEALTHCHECK_TIMEOUT_MS=8000
# Set the actual physical interface on the maintenance computer, e.g. en0 or eth0
VPN_VERIFICATION_INTERFACE=
VPN_EXPECTED_EXIT_COUNTRY=US
VPN_CERTIFICATE_WARNING_HOURS=48
